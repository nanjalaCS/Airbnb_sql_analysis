cells:
  - kind: 1
    value: "--=====================================================================\
      ===========\r

      -- 1. TABLE CREATION (DDL)\r

      --=======================================================================\
      ========="
    languageId: markdown
  - kind: 2
    value: "DROP TABLE airbnb_nyc PURGE;\r

      \r

      CREATE TABLE airbnb_nyc (\r

      \    id                              NUMBER          PRIMARY KEY,\r

      \    name                            VARCHAR2(400),\r

      \    host_id                         NUMBER,\r

      \    host_name                       VARCHAR2(200),\r

      \    neighbourhood_group             VARCHAR2(50),\r

      \    neighbourhood                   VARCHAR2(100),\r

      \    latitude                        NUMBER(9,6),\r

      \    longitude                       NUMBER(9,6),\r

      \    room_type                       VARCHAR2(50),\r

      \    price                           NUMBER(10,2),\r

      \    minimum_nights                  NUMBER,\r

      \    number_of_reviews               NUMBER,\r

      \    last_review                     DATE,\r

      \    reviews_per_month               NUMBER(6,2),\r

      \    calculated_host_listings_count  NUMBER,\r

      \    availability_365                NUMBER\r

      );"
    languageId: oracle-sql
  - kind: 2
    value: "CREATE INDEX ix_airbnb_borough   ON airbnb_nyc(neighbourhood_group);\r

      CREATE INDEX ix_airbnb_roomtype  ON airbnb_nyc(room_type);\r

      CREATE INDEX ix_airbnb_price     ON airbnb_nyc(price);\r

      CREATE INDEX ix_airbnb_host      ON airbnb_nyc(host_id);"
    languageId: oracle-sql
  - kind: 2
    value: "--
      =======================================================================\r

      -- Loading the CSV (SQL Developer Import Wizard + SQL*Loader
      alternative)\r

      --
      ========================================================================\r

      \r

      \r

      INSERT INTO airbnb_nyc (\r

      \    id, name, host_id, host_name, neighbourhood_group, neighbourhood,\r

      \    latitude, longitude, room_type, price, minimum_nights,
      number_of_reviews,\r

      \    last_review, reviews_per_month, calculated_host_listings_count,
      availability_365\r

      )\r

      SELECT\r

      \    id, name, host_id, host_name, neighbourhood_group, neighbourhood,\r

      \    latitude, longitude, room_type, price, minimum_nights,
      number_of_reviews,\r

      \    TO_DATE(NULLIF(TRIM(last_review), ''), 'YYYY-MM-DD'),\r

      \    reviews_per_month, calculated_host_listings_count, availability_365\r

      FROM AIRBNB_NYC_STAGING;\r

      \r

      COMMIT;"
    languageId: oracle-sql
  - kind: 1
    value: "--=====================================================================\
      ===========\r

      -- 3.Data quality checks\r

      --=======================================================================\
      ========="
    languageId: markdown
  - kind: 2
    value: SELECT COUNT(*) FROM AIRBNB_NYC
    languageId: oracle-sql
  - kind: 2
    value: "SELECT * FROM AIRBNB_NYC\r

      FETCH FIRST 5 ROWS ONLY;"
    languageId: oracle-sql
  - kind: 2
    value: "SELECT COUNT(DISTINCT HOST_ID) as HOST,\r

      \r

      ROOM_TYPE\r

      FROM V_AIRBNB_CLEAN\r

      GROUP BY ROOM_TYPE\r\n"
    languageId: oracle-sql
  - kind: 2
    value: DESC AIRBNB_NYC
    languageId: oracle-sql
  - kind: 2
    value: "-- Check for count of null values in each column\r

      \r

      \r

      SELECT \r

      --  SUM(CASE WHEN NAME IS NULL THEN 1 ELSE 0  END) AS missing_name,\r

      --  SUM(CASE WHEN HOST_ID IS NULL THEN 1 ELSE 0 END ) AS missing_hostid,\r

      --  SUM(CASE WHEN HOST_NAME IS NULL THEN 1 ELSE 0 END) AS
      missing_hostname,\r

      --  SUM(CASE WHEN NEIGHBOURHOOD_GROUP IS NULL THEN 1 ELSE 0 END) AS
      missing_group,\r

      --  SUM(CASE WHEN NEIGHBOURHOOD IS NULL THEN 1 ELSE 0 END) AS
      missing_neighborhood,\r

      --  SUM(CASE WHEN LATITUDE IS NULL THEN 1 ELSE 0 END) AS
      missing_latitude,\r

      \ SUM(CASE WHEN PRICE IS NULL THEN 1 ELSE 0 END) AS missing_price,\r

      \ SUM(CASE WHEN LAST_REVIEW IS NULL THEN 1 ELSE 0 END) AS missing_date,\r

      \ SUM(CASE WHEN  REVIEWS_PER_MONTH IS NULL THEN 1 ELSE 0 END) AS
      missing_reviews,\r

      \ SUM(CASE WHEN MINIMUM_NIGHTS  IS NULL THEN 1 ELSE 0 END) AS
      missing_minimum\r

      \ FROM AIRBNB_NYC\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "-- check for duplicate values\r

      SELECT id, \r

      \       COUNT(*) AS cnt\r

      FROM AIRBNB_NYC\r

      GROUP BY id\r

      HAVING COUNT(*) > 1;"
    languageId: oracle-sql
  - kind: 2
    value: "-- FIND LISTING PRICED AT 0\r

      \r

      SELECT COUNT(*) as zero_price_listings\r

      FROM AIRBNB_NYC\r

      WHERE PRICE = 0;"
    languageId: oracle-sql
  - kind: 2
    value: "SELECT id, name, minimum_nights\r

      FROM airbnb_nyc\r

      WHERE minimum_nights > 365\r

      ORDER BY minimum_nights DESC;"
    languageId: oracle-sql
  - kind: 2
    value: "--=====================================================================\
      ===========\r

      -- 4. DATA CLEANING\r

      --=======================================================================\
      ========="
    languageId: oracle-sql
  - kind: 2
    value: "-- replace missing values\r

      CREATE OR REPLACE VIEW v_airbnb_clean AS\r

      SELECT a.*,\r

      NVL(REVIEWS_PER_MONTH, 0 ) AS reviews_per_month_clean,\r

      CASE WHEN MINIMUM_NIGHTS > 365 THEN 365 ELSE MINIMUM_NIGHTS END AS
      minimum_nights_capped\r

      FROM AIRBNB_NYC a\r

      WHERE price > 0\r\n"
    languageId: oracle-sql
  - kind: 1
    value: "--=====================================================================\
      ===========\r

      -- 5. DESCRIPTIVE STATISTICS\r

      --=======================================================================\
      ========="
    languageId: markdown
  - kind: 2
    value: "SELECT\r

      COUNT(PRICE) AS cnt,\r

      ROUND(SUM(PRICE),2) AS total_value,\r

      ROUND(MIN(PRICE),2) AS lowest_price,\r

      ROUND(MAX(PRICE),2) AS highest_price,\r

      ROUND(AVG(PRICE),2) AS mean_price,\r

      ROUND(STDDEV(PRICE),2) AS stddev_price,\r

      ROUND(PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY PRICE),2) AS
      q3_price,\r

      ROUND(PERCENTILE_CONT(0.25) WITHIN GROUP(ORDER BY PRICE),2) AS q1_price\r

      FROM V_AIRBNB_CLEAN\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "SELECT \r

      ROOM_TYPE,\r

      COUNT(PRICE) AS cnt,\r

      ROUND(SUM(PRICE),2) AS total_value,\r

      ROUND(MIN(PRICE),2) AS lowest_price,\r

      ROUND(MAX(PRICE),2) AS highest_price,\r

      ROUND(AVG(PRICE),2) AS mean_price,\r

      ROUND(STDDEV(PRICE),2) AS stddev_price,\r

      ROUND(PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY PRICE),2) AS
      q3_price,\r

      ROUND(PERCENTILE_CONT(0.25) WITHIN GROUP(ORDER BY PRICE),2) AS q1_price\r

      FROM V_AIRBNB_CLEAN\r

      GROUP BY ROOM_TYPE\r

      ORDER BY lowest_price DESC;"
    languageId: oracle-sql
  - kind: 2
    value: "-- Stats summary as per the neighbourhood_group\r

      SELECT\r

      \    neighbourhood_group,\r

      \    COUNT(*)                                   AS n,\r

      \    ROUND(AVG(price),2)                        AS mean_price,\r

      \    ROUND(MEDIAN(price),2)                     AS median_price,\r

      \    ROUND(STDDEV(price),2)                     AS stddev_price,\r

      \    ROUND(AVG(minimum_nights_capped),1)        AS avg_min_nights,\r

      \    ROUND(AVG(number_of_reviews),1)            AS avg_reviews,\r

      \    ROUND(AVG(availability_365),1)             AS avg_availability\r

      FROM v_airbnb_clean\r

      GROUP BY neighbourhood_group\r

      ORDER BY mean_price DESC;"
    languageId: oracle-sql
  - kind: 1
    value: "--=====================================================================\
      ===========\r

      -- 6. DISTRIBUTION & OUTLIER ANALYSIS (IQR method)\r

      --=======================================================================\
      ========="
    languageId: markdown
  - kind: 2
    value: "WITH bound AS (\r

      \    SELECT \r

      \    PERCENTILE_CONT(0.25) WITHIN GROUP(ORDER BY price) AS q1,\r

      \    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY price) AS q3\r

      \    FROM v_airbnb_clean\r

      \ )\r

      \ SELECT\r

      \ b.q1, b.q3,\r

      \ (b.q3 - b.q1) AS iqr,\r

      \ b.q3 + 1.5*(b.q3-b.q1) AS upper_outlier_bound,\r

      \ b.q3 - 1.5*(b.q3- b.q1) AS lower_outlier_bound\r

      \ FROM bound b\r\n"
    languageId: oracle-sql
  - kind: 2
    value: "--identify highest outliers in prices\r

      WITH bound AS (\r

      \    SELECT \r

      \    PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY price) AS q1,\r

      \    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY PRICE) AS q3\r

      \    FROM V_AIRBNB_CLEAN\r

      )\r

      SELECT \r

      \    a.NEIGHBOURHOOD ,\r

      \    a.NEIGHBOURHOOD_GROUP, \r

      \    a.PRICE, \r

      \    a.ROOM_TYPE \r

      FROM  V_AIRBNB_CLEAN a, bound b\r

      WHERE price > b.q3 + 1.5*(b.q3 -b.q1 )\r

      ORDER BY a.PRICE DESC\r

      FETCH FIRST 5 ROWS ONLY;\r

      \      \r\n"
    languageId: oracle-sql
  - kind: 2
    value: DESC V_AIRBNB_CLEAN
    languageId: oracle-sql
  - kind: 2
    value: "--identify (lowest) outliers in prices\r

      WITH bound AS (\r

      \    SELECT \r

      \    PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY price) as q1,\r

      \    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY price) as q3\r

      \    FROM V_AIRBNB_CLEAN\r

      )\r

      SELECT \r

      \    a.NEIGHBOURHOOD_GROUP,\r

      \    a.NEIGHBOURHOOD,\r

      \    a.ROOM_TYPE,\r

      \    a.PRICE \r

      FROM V_AIRBNB_CLEAN a, bound b\r

      WHERE price < b.q3 - 1.5*(b.q3-q1)\r

      ORDER BY price DESC\r

      FETCH FIRST 5 ROWS ONLY"
    languageId: oracle-sql
  - kind: 2
    value: "--bin the price distribution\r

      SELECT \r

      WIDTH_BUCKET(price, 0, 2000, 20) AS price_bucket,\r

      MIN(price) AS min_bucket,\r

      MAX(price) AS max_bucket,\r

      COUNT(*)\r

      FROM V_AIRBNB_CLEAN\r

      GROUP BY WIDTH_BUCKET(price, 0, 2000, 20)\r

      ORDER BY price_bucket"
    languageId: oracle-sql
